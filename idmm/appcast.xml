<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle 2 appcast feed for idmm.

  Production URL: https://hoang.tech/idmm/appcast.xml
  Mirrored from this scaffold into docs/ for public HTTPS hosting. Every release pushes
  a generated <item> with a stapled, notarized DMG and an EdDSA signature.

  Sparkle reads:
    - sparkle:version          -> CFBundleVersion of the new build
    - sparkle:shortVersionString -> marketing version shown to user
    - sparkle:edSignature      -> ed25519 signature of the DMG bytes
    - length                   -> DMG size in bytes
    - sparkle:minimumSystemVersion -> optional gate

  See https://sparkle-project.org/documentation/publishing/ for the
  full release flow.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>idmm - macOS download manager</title>
        <description>Auto-update feed for idmm.</description>
        <language>en</language>
        <link>https://hoang.tech/idmm/</link>

    </channel>
</rss>
